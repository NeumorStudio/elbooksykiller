NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_...) o anon key legacy
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: lookup del email del dueño para notificaciones
SUPABASE_SERVICE_ROLE_KEY=
# Emails de cita (si falta, los envíos se saltan sin romper nada)
RESEND_API_KEY=
EMAIL_FROM=ElBooksyKiller <onboarding@resend.dev>
# Stripe Connect (cobros de cita). Sin STRIPE_SECRET_KEY, reservar un
# servicio con pago falla; sin el webhook secret, todos los webhooks
# devuelven 400 y un pago cuyo cliente cierra la pestaña no se confirma.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dominios propios vía API de Vercel (pestaña "Mi web"). Sin ellas, el
# estado del dominio se queda en "Esperando DNS…" sin explicar por qué.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Asistente de voz del panel (si falta, el botón muestra "no disponible")
GROQ_API_KEY=
# Generación de material de marca (scripts/nanobanana.mjs y kling.mjs);
# solo tooling de diseño, la app no los usa en runtime
GEMINI_API_KEY=
KLING_API_KEY=
# Emails con acceso al panel /admin/super (separados por comas).
# Sin la variable, el panel de superadmin no existe para nadie.
SUPERADMIN_EMAILS=
# ── Desarrollo: qué base usa `npm run dev` ─────────────────────────────
# BD=dev (base de pruebas) o BD=prod (¡clientes reales!). Si no la pones,
# manda lo que haya en NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY.
BD=dev
SUPABASE_DEV_URL=
SUPABASE_DEV_ANON_KEY=
SUPABASE_DEV_SERVICE_ROLE_KEY=
SUPABASE_PROD_URL=
SUPABASE_PROD_ANON_KEY=
SUPABASE_PROD_SERVICE_ROLE_KEY=
# Secreto de los endpoints /api/cron/*. SIN ESTA VARIABLE LOS CRONS
# DEVUELVEN 503: es obligatoria en producción.
CRON_SECRET=
# Dirección pública de la plataforma. La usan los emails que salen de un
# cron, donde no hay petición de la que deducir el host. Sin ella los
# enlaces apuntan a localhost y el cliente recibe un enlace muerto.
PLATFORM_URL=https://reservas.neumorstudio.com
# ── Plataforma cerrada mientras no se cobre ────────────────────────────
# Con un valor aquí, crear un salón exige ese código: registrarse sigue
# siendo libre, pero no se puede publicar un salón sin invitación.
ALTA_INVITACION=
# =1 para que el escaparate de Salonio se indexe en buscadores. Apagado
# por defecto: es una página de venta y el plan Hobby de Vercel prohíbe el
# uso comercial. Encender solo al pasar a Pro.
PLATAFORMA_INDEXABLE=
# ── Aviso legal (art. 10 LSSI-CE) ──────────────────────────────────────
# OBLIGATORIAS antes de abrir la web de un salón al público. Si faltan,
# /legal enseña «pendiente de completar» en su sitio: es a propósito, un
# dato legal inventado es peor que un hueco visible.
LEGAL_TITULAR=
LEGAL_NIF=
LEGAL_DOMICILIO=
LEGAL_EMAIL=
# ── Notificaciones push (recordatorio de 1 h) ──────────────────────────
# Par de claves VAPID: `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# Sin ellas el botón «Avisarme en el móvil» no aparece y el recordatorio
# sigue yendo solo por email. La pública va al navegador (NEXT_PUBLIC_);
# la privada NUNCA. Si se regeneran, todas las suscripciones existentes
# dejan de funcionar y hay que volver a pedir permiso.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A quién avisa el servicio de push si algo va mal con nuestros envíos.
VAPID_SUBJECT=mailto:tu@correo.com
